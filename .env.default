# JU Portal - committed PUBLIC defaults. No secret lives in this file.
#
# This is the committed, zero-secret configuration a clean checkout builds with,
# so `npm run build && npm test` are deterministic without a local .env.local.
# Every value here is public (production origin, radar origin, a link target).
#
# Precedence, lowest to highest:
#   .env.default (this file)  <  .env  <  .env.local  <  process env / Vercel
#
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is injected at build time and wins,
# which is the production source of truth for canonical / og:url.

# Production canonical origin. Public by definition.
NEXT_PUBLIC_SITE_URL=https://ju-portal-one.vercel.app

NEXT_PUBLIC_GITHUB_ORG=ju0o
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Local Portal media renders as the Registry pathname unchanged, so it is
# same-origin by construction. No external media provider at V0.
PUBLIC_MEDIA_BASE_URL=
RADAR_ORIGIN=https://juradar-907c6.web.app