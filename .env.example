# JU Portal - environment reference.
#
# You do NOT need to copy this file to build.
#
# `.env.default` is committed and carries every public value a clean checkout
# needs (production canonical origin, radar origin, media, GitHub org), so
#
#   npm run build && npm test
#
# are deterministic with zero secrets and zero local setup.
#
# Copy this to `.env.local` ONLY to override a value locally. `.env.local` is
# gitignored and never required. Precedence, lowest to highest:
#
#   .env.default  <  .env  <  .env.local  <  process env / Vercel
#
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is injected at build time on every
# deployment, preview included, and always wins. It is the source of truth for
# canonical / og:url. Never set it by hand.
#
# Infra owner: Web Operations. See docs/SSOT.md

# ── Canonical origin: NO manual value needed anywhere ──────
# Vercel injects this at build time. For local builds it stays unset and
# NEXT_PUBLIC_SITE_URL below is used instead. Never set it by hand.
# VERCEL_PROJECT_PRODUCTION_URL=ju-portal-one.vercel.app

# ── Local / manual fallback ONLY ─────────────────────────
# Used when VERCEL_PROJECT_PRODUCTION_URL is absent (local dev, non-Vercel CI).
# Already set to the production origin in the committed .env.default; override
# here only if you need a different canonical while experimenting.
NEXT_PUBLIC_SITE_URL=https://ju-portal-one.vercel.app

NEXT_PUBLIC_GITHUB_ORG=ju0o
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ── Media ────────────────────────────────────────────────
# NOT required at V0. Local Portal media is rendered as the Registry pathname
# unchanged (e.g. /media/juqode/overview.v1.mp4), so it is same-origin by
# construction. Reserved for a future external CDN / media provider.
PUBLIC_MEDIA_BASE_URL=
RELEASE_PROVIDER_DEFAULT=github_release
RELEASE_RESOLVER_MODE=build
RELEASE_CACHE_TTL_SECONDS=900
RADAR_ORIGIN=https://juradar-907c6.web.app

# ── Optional ─────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_URL=

# ── Secrets (never commit) ───────────────────────────────
# Only needed by optional release-resolution flows, never by build/test/verify.
RELEASE_GITHUB_TOKEN=