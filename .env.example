# JU Portal — copy to .env.local and fill in. Never commit a real .env
# Infra owner: Web Operations. See docs/SSOT.md

# ── Canonical origin: NO manual value needed on Vercel ──
# Vercel injects this at build time on every deployment, preview included.
# It is the source of truth for canonical / og:url. Never set it by hand.
# VERCEL_PROJECT_PRODUCTION_URL=ju-portal-one.vercel.app

# ── Local / manual fallback ONLY ───────────────────────
# Used only when VERCEL_PROJECT_PRODUCTION_URL is absent (local dev, non-Vercel CI).
# On Vercel this is ignored, so a stale value here cannot break production.
NEXT_PUBLIC_SITE_URL=https://ju-portal-one.vercel.app

NEXT_PUBLIC_GITHUB_ORG=ju0o
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# ── Media ───────────────────────────────────────────────
# NOT required at V0. Local Portal media is rendered as the Registry pathname
# unchanged (e.g. /media/juqode/overview.v1.mp4), so it is same-origin by
# construction. Reserved for a future external CDN / media provider.
PUBLIC_MEDIA_BASE_URL=
RELEASE_PROVIDER_DEFAULT=github_release
RELEASE_RESOLVER_MODE=build
RELEASE_CACHE_TTL_SECONDS=900
RADAR_ORIGIN=https://juradar-907c6.web.app

# ── Optional ───────────────────────────────────────────
NEXT_PUBLIC_CONTACT_URL=
RELEASE_GITHUB_TOKEN=
